  "components": {
    "schemas": {
      "ConsumeRecordResponse": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "frame_bytes": {
            "type": "integer",
            "title": "Frame Bytes"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "index",
          "frame_bytes",
          "url"
        ],
        "title": "ConsumeRecordResponse"
      },
      "CreateDropRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "text",
            "title": "Kind",
            "default": "text"
          },
          "ttl_seconds": {
            "type": "integer",
            "enum": [
              3600,
              86400,
              604800
            ],
            "title": "Ttl Seconds"
          },
          "max_views": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Views"
          },
          "size_hint": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2162714.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Hint"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ttl_seconds",
          "max_views"
        ],
        "title": "CreateDropRequest",
        "description": "Validated public input for reserving a text drop."
      },
      "CreateDropResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "owner_token": {
            "type": "string",
            "title": "Owner Token"
          },
          "limits": {
            "$ref": "#/components/schemas/DropLimits"
          }
        },
        "type": "object",
        "required": [
          "id",
          "owner_token",
          "limits"
        ],
        "title": "CreateDropResponse"
      },
      "DropConsumeResponse": {
        "properties": {
          "envelope": {
            "type": "string",
            "title": "Envelope"
          },
          "password_required": {
            "type": "boolean",
            "title": "Password Required"
          },
          "record_count": {
            "type": "integer",
            "title": "Record Count"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "views_remaining": {
            "type": "integer",
            "title": "Views Remaining"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/ConsumeRecordResponse"
            },
            "type": "array",
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "envelope",
          "password_required",
          "record_count",
          "expires_at",
          "views_remaining",
          "records"
        ],
        "title": "DropConsumeResponse"
      },
      "DropLimits": {
        "properties": {
          "chunk_size": {
            "type": "integer",
            "title": "Chunk Size",
            "default": 2097152
          },
          "max_metadata_plaintext": {
            "type": "integer",
            "title": "Max Metadata Plaintext",
            "default": 65536
          },
          "max_text_bytes": {
            "type": "integer",
            "title": "Max Text Bytes",
            "default": 2097152
          }
        },
        "type": "object",
        "title": "DropLimits"
      },
      "DropMetadataResponse": {
        "properties": {
          "state": {
            "type": "string",
            "const": "active",
            "title": "State"
          },
          "password_required": {
            "type": "boolean",
            "title": "Password Required"
          },
          "envelope": {
            "type": "string",
            "title": "Envelope"
          },
          "record_count": {
            "type": "integer",
            "title": "Record Count"
          },
          "ciphertext_bytes": {
            "type": "integer",
            "title": "Ciphertext Bytes"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "views_remaining": {
            "type": "integer",
            "title": "Views Remaining"
          }
        },
        "type": "object",
        "required": [
          "state",
          "password_required",
          "envelope",
          "record_count",
          "ciphertext_bytes",
          "expires_at",
          "views_remaining"
        ],
        "title": "DropMetadataResponse"
      },
      "FinalizeDropRequest": {
        "properties": {
          "record_count": {
            "type": "integer",
            "maximum": 1048577.0,
            "minimum": 1.0,
            "title": "Record Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "record_count"
        ],
        "title": "FinalizeDropRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
