        "operationId": "upload_text_record_v1_drops__drop_id__records__index__put",
        "parameters": [
          {
            "name": "drop_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Drop Id"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
