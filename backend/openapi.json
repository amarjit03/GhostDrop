    "/v1/drops/{drop_id}/consume": {
      "post": {
        "tags": [
          "Drops"
        ],
        "summary": "Consume Drop",
        "description": "Reserve one view and return signed URLs for the encrypted records.",
        "operationId": "consume_drop_v1_drops__drop_id__consume_post",
        "parameters": [
          {
            "name": "drop_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
